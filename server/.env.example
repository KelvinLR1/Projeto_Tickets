# Variáveis de Ambiente para PostgreSQL
# Renomeie este arquivo para .env e configure as variáveis abaixo

# Banco de Dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/ticketflow

# Ou para SQLite (padrão se não definir DATABASE_URL)
# DATABASE_URL=sqlite:///./tickets_system.db

# Configurações de Segurança (opcional)
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
